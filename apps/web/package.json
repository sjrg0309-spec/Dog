{
  "name": "@coincide/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --port 3000 --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --dir app --dir components --dir lib",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "screenshots": "node ../../scripts/screenshots.mjs"
  },
  "dependencies": {
    "@coincide/core": "workspace:*",
    "@coincide/tokens": "workspace:*",
    "next": "^15.1.3",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@playwright/test": "^1.49.1",
    "@axe-core/playwright": "^4.10.1"
  }
}