# Enlazado aislado (el de por defecto en pnpm) a propósito.
#
# Este monorepo tiene dos versiones de React conviviendo: la web va con React 19,
# que es lo que pide Next 15, y Expo SDK 52 va con la 18.3.1. Con node_modules
# plano una de las dos gana en la raíz y la otra aplicación se rompe con el
# clásico "Cannot read properties of null (reading 'useContext')", que es lo que
# pasa cuando hay dos copias de React en juego.
#
# El coste de aislar es que Metro no encuentra algunas dependencias transitivas
# que Expo usa sin declarar. Se resuelve declarándolas en apps/mobile, que es una
# lista corta y explícita, en lugar de aplanar todo el árbol.
shamefully-hoist=false
